/bin/
*.test
*.out
coverage.out

# go-anything project state: reports, round checks, defect lists
.go-anything/

# compiled binaries built inside a package directory
/cmd/go-anything/go-anything
/go-anything
/dist/

# per-operator agent tooling (the implementer agent used while building this)
.claude/
.codex/
.gemini/
.pi/

# stub files the claude-mem plugin writes into sub-folders; only the root guide file is tracked
CLAUDE.md
!/CLAUDE.md

# per-task working state is not committed (see effort-router §5)
docs/task-id/

# work results live under WORK/; only the folder rules file is tracked
WORK/*
!WORK/README.md
